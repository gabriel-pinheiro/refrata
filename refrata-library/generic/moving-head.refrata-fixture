        { "key": "dimmer", "element": "root" },
        { "key": "strobe", "element": "root" },
        { "key": "red", "element": "root" },
        { "key": "green", "element": "root" },
        { "key": "blue", "element": "root" },
        { "key": "white", "element": "root" }
      ],
      "shape": { "template": "single" },
      "elements": {
        "root": {
          "name": "Moving Head",
          "parameters": {
            "pan": {
              "default": 0,
              "encode": { "scale": "pan" }
            },
            "tilt": {
              "default": 0,
              "encode": { "scale": "tilt" }
            },
            "dimmer": {
              "default": 0,
              "highlight": 1,
              "encode": { "scale": "dimmer" }
            },
            "strobe": {
              "default": 0,
              "highlight": 0,
              "encode": { "scale": "strobe" }
            },
            "color": {
              "default": [0, 0, 0, 1],
              "highlight": [1, 1, 1, 1],
              "encode": { "color": ["red", "green", "blue", "white"] }
            }
