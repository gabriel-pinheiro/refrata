{
  "name": "refrata",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "refrata-core",
    "refrata-protocol",
    "refrata-client",
    "refrata-runtime",
    "refrata-studio",
    "refrata-cli",
    "refrata-desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "npm run build -w @refrata/studio -w @refrata/desktop && npm run start -w @refrata/desktop --",
    "package:desktop": "npm run build -w @refrata/studio -w @refrata/desktop && npm run package -w @refrata/desktop --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "test": "vitest run",
    "check": "run-p -l typecheck test lint format:check",
    "test:desktop": "npm run test:desktop -w @refrata/desktop",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
