{
  "name": "@refrata/desktop",
  "productName": "Refrata",
  "desktopName": "refrata.desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Refrata Desktop: a window that shows Studio, from a Runtime it runs on this machine or from one elsewhere.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:desktop": "vitest run --config e2e/vitest.config.ts",
    "package": "node scripts/stage-addons.mjs && electron-builder --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@refrata/client": "0.3.0",
    "@refrata/core": "0.3.0",
    "@refrata/protocol": "0.3.0",
    "@refrata/runtime": "0.3.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "~1.61.1",
    "zod": "^4.4.3"
  }
}
